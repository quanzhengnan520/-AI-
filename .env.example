# M1 server-only configuration. Copy to services/api/.env; do not commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./data/secondbrain.db
APP_TIMEZONE=Asia/Shanghai
MOCK_MODE=true
LIVE_AI_ENABLED=false
LLM_PROVIDER=mock
# Opt-in Live: set MOCK_MODE=false, LIVE_AI_ENABLED=true and
# LLM_PROVIDER=openai_compatible; fill ALL fields below only on the server.
# Each extraction also requires the client's explicit allow_live_ai confirmation.
# Base URL must use HTTPS/443 and a public DNS host in the exact allowlist.
# Redirects, local/private addresses, URL credentials/query strings are rejected.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_ALLOWED_HOSTS=
ASR_PROVIDER=mock
# M0 /demo only. M1 records use persistent, one-use-code paired devices.
# Empty means protected demo resources refuse access. No shared default token.
# scripts/new-dev-token.ps1 writes only a locally generated SHA-256 hash here.
DEVICE_TOKEN_SHA256=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MAX_REQUEST_BYTES=32768
